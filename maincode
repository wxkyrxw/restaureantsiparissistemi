import tkinter as tk
from tkinter import messagebox
import ctypes

# --- 720p GÖRÜNTÜ KALİTESİ (DPI AWARENESS) ---
# Windows'ta bulanık görünümü (144p hissini) engelleyip yazıları cam gibi (720p+) net yapar.
try:
    ctypes.windll.shcore.SetProcessDpiAwareness(1)
except:
    pass # Mac veya Linux ise bu adımı atlar

# --- RENK PALETİ (Siyah, Koyu Gri ve Koyu Turuncu) ---
BG_SIYAH = "#0a0a0a"       # Arka plan
KART_GRI = "#1a1a1a"       # Menü kartları
KART_HOVER = "#262626"     # Menü kartı üzerine gelince
TURUNCU = "#d35400"        # Koyu turuncu detaylar
TURUNCU_HOVER = "#e67e22"  # Buton üzerine gelince açık turuncu
BEYAZ_METIN = "#f0f0f0"
GRI_METIN = "#8c8c8c"

# --- YARDIMCI ANİMASYON FONKSİYONLARI ---
# Renkleri Hexadecimal'den RGB'ye çevirip yavaş yavaş karıştırır (Fade efekti için)
def hex_to_rgb(hex_color):
    hex_color = hex_color.lstrip('#')
    return tuple(int(hex_color[i:i+2], 16) for i in (0, 2, 4))

def fade_animasyonu(canvas, item_id, baslangic_hex, bitis_hex, adim=0, max_adim=15):
    if adim <= max_adim:
        r1, g1, b1 = hex_to_rgb(baslangic_hex)
        r2, g2, b2 = hex_to_rgb(bitis_hex)
        
        r = int(r1 + (r2 - r1) * (adim / max_adim))
        g = int(g1 + (g2 - g1) * (adim / max_adim))
        b = int(b1 + (b2 - b1) * (adim / max_adim))
        
        yeni_renk = f"#{r:02x}{g:02x}{b:02x}"
        canvas.itemconfig(item_id, fill=yeni_renk)
        # 15 milisaniyede bir kendini tekrar çağırarak pürüzsüz geçiş (fade) sağlar
        canvas.after(15, fade_animasyonu, canvas, item_id, baslangic_hex, bitis_hex, adim + 1, max_adim)

# --- OVAL ÇİZİM FONKSİYONU ---
# Tkinter'da oval köşeli kartlar oluşturmak için poligon matematiği
def oval_dikdortgen_ciz(canvas, x1, y1, x2, y2, yaricap=25, **kwargs):
    noktalar = [x1+yaricap, y1, x1+yaricap, y1, x2-yaricap, y1, x2-yaricap, y1, x2, y1, x2, y1+yaricap, x2, y1+yaricap, x2, y2-yaricap, x2, y2-yaricap, x2, y2, x2-yaricap, y2, x2-yaricap, y2, x1+yaricap, y2, x1+yaricap, y2, x1, y2, x1, y2-yaricap, x1, y2-yaricap, x1, y1+yaricap, x1, y1+yaricap, x1, y1]
    return canvas.create_polygon(noktalar, **kwargs, smooth=True)

